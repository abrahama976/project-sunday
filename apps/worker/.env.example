SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
TFNSW_API_KEY=
OPENROUTESERVICE_API_KEY=   # free key, no card: openrouteservice.org/dev/#/signup
GROQ_API_KEY=          # Optional. Get free key at console.groq.com. Enables Llama 3.3 70B fallback.
TAVILY_API_KEY=          # tavily.com — 1000 searches/month free
NTFY_TOPIC=              # e.g. sunday-abc123
USER_LAT=-33.8688
USER_LNG=151.2093
USER_TIMEZONE=Australia/Sydney

# ── Model IDs (optional) ───────────────────────────────────────────────────
# Names only: defaults live in config.py and were verified live on 2026-11-17.
# Set one of these when a provider retires an ID — no code change needed.
GEMINI_MODEL=
GEMINI_LITE_MODEL=
NVIDIA_API_KEY=          # optional; integrate.api.nvidia.com — skipped when empty
NVIDIA_MODEL=
NVIDIA_BASE_URL=
GROQ_MODEL=
OLLAMA_MODEL=
OLLAMA_HOST=             # default http://localhost:11434
